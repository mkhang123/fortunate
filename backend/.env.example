# Database
DB_URL="postgresql://user:password@localhost:5432/fortunate"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# VTON (Virtual Try-On)
VTON_MODE="python"  # Options: mock, replicate, huggingface, python
PYTHON_VTON_API_URL="http://localhost:5000"
REPLICATE_API_TOKEN="your-replicate-token"
HF_API_TOKEN="your-huggingface-token"

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Payment (VNPay)
VNP_MERCHANT_ID="your-merchant-id"
VNP_HASH_SECRET="your-hash-secret"
VNP_API_URL="https://sandbox.vnpayment.vn"

# Server
PORT=4000
NODE_ENV=development
