generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model User {
  email         String                @unique
  password      String?
  name          String?
  avatar        String?
  role          Role                  @default(USER)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  id            Int                   @id @default(autoincrement())
  isActive      Boolean               @default(true)
  phone         String?
  refreshToken  String?
  googleId      String?               @unique
  addresses     Address[]
  cart          Cart?
  notifications Notification[]
  orders        Order[]
  reviews       Review[]
  bodyProfile   UserBodyProfile?
  tryOns        VirtualTryOnSession[]
  wishlist      Wishlist[]

  @@index([email])
}

model Address {
  phone     String
  address   String
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int
  userName  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Brand {
  name      String    @unique
  slug      String    @unique
  logo      String?
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  isActive  Boolean   @default(true)
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  name         String
  slug         String    @unique
  id           Int       @id @default(autoincrement())
  displayOrder Int       @default(0)
  image        String?
  isActive     Boolean   @default(true)
  products     Product[]

  @@index([slug])
}

model Product {
  name       String
  slug       String           @unique
  status     ProductStatus    @default(DRAFT)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  id         Int              @id @default(autoincrement())
  brandId    Int?
  categoryId Int
  images     String[]
  price      Float?
  brand      Brand?           @relation(fields: [brandId], references: [id])
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]
  reviews    Review[]
  wishlists  Wishlist[]

  @@index([categoryId, status])
  @@index([brandId])
}

model ProductVariant {
  color       String
  size        String
  price       Float
  stock       Int                   @default(0)
  id          Int                   @id @default(autoincrement())
  productId   Int
  cartItems   CartItem[]
  orderItems  OrderItem[]
  measurement ProductMeasurement?
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  tryOns      VirtualTryOnSession[]

  @@unique([productId, color, size])
  @@index([productId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  quantity  Int
  id        Int            @id @default(autoincrement())
  cartId    Int
  variantId Int
  updatedAt DateTime       @default(now()) @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Order {
  status          OrderStatus @default(PENDING)
  total           Float
  createdAt       DateTime    @default(now())
  id              Int         @id @default(autoincrement())
  userId          Int
  notes           String?
  receiverEmail   String?
  receiverName    String?
  receiverPhone   String?
  shippingAddress String
  trackingNumber  String?
  city            String?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payment         Payment?

  @@index([userId, status])
  @@index([createdAt])
}

model OrderItem {
  price     Float
  quantity  Int
  id        Int            @id @default(autoincrement())
  orderId   Int
  variantId Int
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Payment {
  method            PaymentMethod @default(VNPAY)
  status            PaymentStatus @default(PENDING)
  vnp_TransactionNo String?
  vnp_ResponseCode  String?
  vnp_OrderInfo     String?
  paidAt            DateTime?
  amount            Float
  id                Int           @id @default(autoincrement())
  orderId           Int           @unique
  metadata          Json?
  txnRef            String?       @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([txnRef])
}

model Notification {
  title     String
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  id        Int       @id @default(autoincrement())
  userId    Int
  link      String?
  readAt    DateTime?
  type      String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Review {
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())
  id               Int      @id @default(autoincrement())
  userId           Int
  productId        Int
  images           String[]
  verifiedPurchase Boolean  @default(false)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, rating])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  addedAt   DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model UserBodyProfile {
  height    Float
  weight    Float
  chest     Float
  waist     Float
  hip       Float
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  unit      String    @default("cm")
  updatedAt DateTime  @updatedAt
  bodyType  BodyType?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductMeasurement {
  chest     Float?
  waist     Float?
  hip       Float?
  length    Float?
  id        Int            @id @default(autoincrement())
  variantId Int            @unique
  unit      String         @default("cm")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model AIModel {
  name        String
  version     String
  description String?
  id          Int                   @id @default(autoincrement())
  sessions    VirtualTryOnSession[]
}

model VirtualTryOnSession {
  inputImage     String
  outputImage    String
  createdAt      DateTime        @default(now())
  id             Int             @id @default(autoincrement())
  userId         Int
  variantId      Int?
  aiModelId      Int?
  processingTime Int?
  status         String          @default("COMPLETED")
  aiModel        AIModel?        @relation(fields: [aiModelId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([userId, createdAt])
}

enum Role {
  USER
  ADMIN
  CREATOR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  REJECTED
  OUT_OF_STOCK
  ARCHIVED
}

enum BodyType {
  RECTANGLE
  TRIANGLE
  INVERTED_TRIANGLE
  HOURGLASS
  OVAL
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  VNPAY
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
